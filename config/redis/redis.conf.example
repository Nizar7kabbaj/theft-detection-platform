# Network
bind 0.0.0.0
port 6379
protected-mode yes

# Security
requirepass __REDIS_PASSWORD_PLACEHOLDER__
user ai on >SET_PASSWORD ~ai:track:* resetchannels +@connection +xadd +xrange +xlen +expire +del +ping
user api on >SET_PASSWORD ~cache:* ~idem:* resetchannels &alerts:* &cameras:* +@connection +get +set +del +scan +publish +subscribe +unsubscribe +psubscribe +punsubscribe

# Persistence
appendonly yes
appendfsync everysec
save ""

# Logging
loglevel notice
logfile ""

# Misc
databases 16
