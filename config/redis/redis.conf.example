# Network
bind 0.0.0.0
port 0
protected-mode yes

# Security
requirepass __REDIS_PASSWORD_PLACEHOLDER__
aclfile /etc/redis/redis.acl

# Persistence
appendonly yes
appendfsync everysec
save ""

# Logging
loglevel notice
logfile ""

# Misc
databases 16

tls-port 6380
tls-cert-file /etc/redis/tls/tls.crt
tls-key-file /etc/redis/tls/tls.key
tls-ca-cert-file /etc/redis/tls/ca.crt
tls-auth-clients yes
tls-protocols "TLSv1.3"
