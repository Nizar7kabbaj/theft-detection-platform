# Network
bind 0.0.0.0
port 6379
protected-mode yes

# Security
requirepass __REDIS_PASSWORD_PLACEHOLDER__
user default on >SET_PASSWORD ~* &* -@all +ping +@connection
user api on >SET_PASSWORD ~cache:* ~idem:* resetchannels &alerts:* &cameras:* -@all +@connection +get +set +del +scan +publish +subscribe +unsubscribe +psubscribe +punsubscribe
user exporter on >SET_PASSWORD resetchannels ~* -@all +@connection +info +client +ping +latency +slowlog

# Persistence
appendonly yes
appendfsync everysec
save ""

# Logging
loglevel notice
logfile ""

# Misc
databases 16
