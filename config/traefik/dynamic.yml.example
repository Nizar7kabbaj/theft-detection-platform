tls:
  certificates:
    - certFile: /etc/traefik/certs/localhost.crt
      keyFile: /etc/traefik/certs/localhost.key
  options:
    default:
      minVersion: VersionTLS13
      sniStrict: false
http:
  middlewares:
    rate-limit-dev:
      rateLimit:
        average: 2000
        burst: 4000
        period: 1s
    rate-limit-per-ip:
      rateLimit:
        average: 10
        burst: 50
        period: 1s
    login-rate-limit:
      rateLimit:
        average: 5
        burst: 10
        period: 1s
    security-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        referrerPolicy: strict-origin-when-cross-origin
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: false
        customResponseHeaders:
          Server: ""
          X-Powered-By: ""
          X-XSS-Protection: "0"
          Permissions-Policy: "camera=(), microphone=(), geolocation=(), browsing-topics=()"
          Cross-Origin-Resource-Policy: same-site
          Cross-Origin-Opener-Policy: same-origin
    json-csp:
      headers:
        customResponseHeaders:
          Content-Security-Policy: "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    gateway-chain:
      chain:
        middlewares:
          - rate-limit-per-ip
          - security-headers
    dev-chain:
      chain:
        middlewares:
          - rate-limit-dev
          - security-headers
    api-chain:
      chain:
        middlewares:
          - rate-limit-per-ip
          - security-headers
          - json-csp
    login-chain:
      chain:
        middlewares:
          - login-rate-limit
          - security-headers
          - json-csp
