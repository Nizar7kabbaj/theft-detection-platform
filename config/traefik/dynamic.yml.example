tls:
  certificates:
    - certFile: /etc/traefik/certs/localhost.crt
      keyFile: /etc/traefik/certs/localhost.key
  options:
    default:
      minVersion: VersionTLS13
      sniStrict: false

http:
  middlewares:
    rate-limit-per-ip:
      rateLimit:
        average: 10
        burst: 50
        period: 1s
        sourceCriterion:
          ipStrategy:
            depth: 1

    security-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: strict-origin-when-cross-origin
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: false
        customResponseHeaders:
          Server: ""
          X-Powered-By: ""

    gateway-chain:
      chain:
        middlewares:
          - rate-limit-per-ip
          - security-headers
