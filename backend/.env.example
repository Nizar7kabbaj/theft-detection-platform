# MongoDB — local Docker (dev default)
MONGODB_URL_LOCAL=mongodb://<USER>:<PASSWORD>@127.0.0.1:27017/<DATABASE>?tls=true&tlsCAFile=<PATH-TO-MONGO-CA-CRT>&authSource=<DATABASE>

# MongoDB — Atlas (production fallback)
MONGODB_URL=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/?appName=<APPNAME>
DATABASE_NAME=theft_detection_db
MONGODB_MODE=local
# Redis — local Docker (dev default)
# No username, AUTH only, no TLS see docs/05-platform-services.md
REDIS_URL_LOCAL=redis://:<PASSWORD>@127.0.0.1:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Security
SECRET_KEY=<generate-with-openssl-rand-hex-32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage
SNAPSHOTS_DIR=ai-model/outputs/snapshots
ALERTS_DIR=ai-model/outputs/alerts

# Telegram
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>

# Local monitoring (exporters)
MONGO_EXPORTER_USERNAME=theft_monitor
MONGO_EXPORTER_PASSWORD=<password-generated-during-install>
REDIS_PASSWORD_LOCAL=<password-from-REDIS_URL_LOCAL>

# Grafana — local Docker admin password
GF_SECURITY_ADMIN_PASSWORD=<password-generated-during-install>

# OpenTelemetry
OTEL_SERVICE_NAME=theft-backend
OTEL_RESOURCE_ATTRIBUTES=service.namespace=theft,deployment.environment=local,service.version=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://theft-alloy:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus
OTEL_LOGS_EXPORTER=none
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] [trace_id=%(otelTraceID)s span_id=%(otelSpanID)s] %(message)s
PROMETHEUS_EXPORTER_PORT=9464
