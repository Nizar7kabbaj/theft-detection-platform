{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "defaults", "components", "identities", "routes", "migrations", "seed", "metrics", "networkPolicy"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "image", "otel", "gateway", "pki", "postgres", "snapshots"],
      "properties": {
        "environment": { "type": "string", "enum": ["local", "dev", "prod"] },
        "storeTimeZone": { "type": "string", "minLength": 1 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "otel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string", "pattern": "^https?://" },
            "protocol": { "type": "string", "enum": ["grpc", "http/protobuf", "http/json"] },
            "tracesExporter": { "type": "string" },
            "metricsExporter": { "type": "string" },
            "logsExporter": { "type": "string" },
            "pythonLogCorrelation": { "type": "string", "enum": ["true", "false"] },
            "pythonLogFormat": { "type": "string" }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name", "namespace", "sectionName", "hostname"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "sectionName": { "type": "string", "minLength": 1 },
            "hostname": { "type": "string", "minLength": 1 }
          }
        },
        "pki": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuerName", "issuerKind", "trustDomain", "duration", "renewBefore"],
          "properties": {
            "issuerName": { "type": "string", "minLength": 1 },
            "issuerKind": { "enum": ["Issuer", "ClusterIssuer"] },
            "trustDomain": { "type": "string", "minLength": 1 },
            "duration": { "type": "string" },
            "renewBefore": { "type": "string" }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "port", "caSecret", "psqlImage"],
          "properties": {
            "host": { "type": "string", "minLength": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "caSecret": { "type": "string", "minLength": 1 },
            "psqlImage": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" }
          }
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size", "storageClassName", "accessMode"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClassName": { "type": "string" },
            "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteMany"] },
            "local": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "node"],
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "node": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "defaults": { "$ref": "#/$defs/podSettings", "unevaluatedProperties": false },
    "identities": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server"],
        "properties": {
          "server": { "type": "boolean" },
          "dnsNames": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headerSets", "rules"],
      "properties": {
        "headerSets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "set": { "type": "object", "additionalProperties": { "type": "string" } },
              "remove": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "component", "port", "headerSet", "matches"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
              "component": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "headerSet": { "type": "string" },
              "matches": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "value"],
                  "properties": {
                    "type": { "enum": ["Exact", "PathPrefix"] },
                    "value": { "type": "string", "pattern": "^/" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "component", "database", "ownerUser", "ownerSecret", "ownerPasswordKey", "command", "preSql", "postSql"],
        "properties": {
          "enabled": { "type": "boolean" },
          "component": { "type": "string" },
          "database": { "type": "string" },
          "ownerUser": { "type": "string" },
          "ownerSecret": { "type": "string" },
          "ownerPasswordKey": { "type": "string" },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "preSql": { "type": "string" },
          "postSql": { "type": "string" }
        }
      }
    },
    "documentMigrations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "component", "egress", "command", "secretItems", "caFrom"],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "component": {
            "type": "string"
          },
          "egress": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to", "ports"],
              "properties": {
                "to": {
                  "type": "string"
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "secretItems": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "caFrom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secret", "path"],
            "properties": {
              "secret": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "auditOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "component", "secret", "name", "args", "ttlSecondsAfterFinished"],
      "properties": {
        "run": { "type": "boolean" },
        "component": { "type": "string", "minLength": 1 },
        "secret": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)?$" },
        "args": { "type": "array", "items": { "type": "string" } },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 60 }
      }
    },
    "modelImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "accessLabelPrefix", "ambient", "dns", "peers", "jobEgress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "accessLabelPrefix": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
        "dns": { "type": "object", "additionalProperties": false, "required": ["namespace", "podLabels", "port"], "properties": { "namespace": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" }, "podLabels": { "type": "object", "additionalProperties": { "type": "string" } }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } } },
        "ambient": { "type": "object", "additionalProperties": false, "required": ["enabled", "hbonePort", "probeSource", "trustDomain"], "properties": { "enabled": { "type": "boolean" }, "hbonePort": { "type": "integer", "minimum": 1, "maximum": 65535 }, "probeSource": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" }, "trustDomain": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$" } } },
        "peers": {
          "type": "object",
          "required": ["gateway", "prometheus"],
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "access": { "type": "boolean" },
              "namespace": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
              "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
              "cidrs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" } },
              "serviceAccount": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$" }
            }
          }
        },
        "jobEgress": { "type": "array", "items": { "$ref": "#/$defs/egressRule" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "jobs"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "jobs": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "component", "secret", "appSecretKeys", "users"],
      "properties": {
        "enabled": { "type": "boolean" },
        "component": { "type": "string", "minLength": 1 },
        "secret": { "type": "string", "minLength": 1 },
        "appSecretKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["username", "roles"],
            "properties": {
              "username": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,49}$" },
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["admin", "operator", "viewer", "ml_engineer", "compliance", "detector"]
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "ingressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "ports"],
      "properties": {
        "from": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
      }
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "ports"],
      "properties": {
        "to": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory": { "type": "string" }
          }
        }
      }
    },
    "podSettings": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "cpuUtilization": { "type": "integer", "minimum": 10, "maximum": 100 },
            "scaleUpStabilizationSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
            "scaleDownStabilizationSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "required": [
              "minReplicas",
              "maxReplicas",
              "cpuUtilization",
              "scaleUpStabilizationSeconds",
              "scaleDownStabilizationSeconds"
            ]
          }
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] }
          }
        },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "automountServiceAccountToken": { "type": "boolean" },
        "podSecurityContext": { "$ref": "#/$defs/podSecurityContext" },
        "containerSecurityContext": { "$ref": "#/$defs/containerSecurityContext" },
        "writablePaths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "uniqueItems": true
        },
        "resources": { "$ref": "#/$defs/resources" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "lifecycle": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "startupProbe": { "type": "object" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "privileged": { "const": false },
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "type": "boolean" }
      }
    },
    "component": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/podSettings" }],
      "unevaluatedProperties": false,
      "required": ["enabled", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "egress": { "type": "array", "items": { "$ref": "#/$defs/egressRule" } },
        "ingress": { "type": "array", "items": { "$ref": "#/$defs/ingressRule" } },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" }
          }
        },
        "otel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "serviceName": { "type": "string", "minLength": 1 }
          }
        },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "containerPort"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,13}[a-z0-9])?$" },
              "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "ports": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "port", "targetPort"],
                "properties": {
                  "name": { "type": "string" },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "targetPort": { "type": ["string", "integer"] }
                }
              }
            }
          }
        },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "secretEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "secret", "key"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
              "secret": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 }
            }
          }
        },
        "secret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "mountPath": { "type": "string", "pattern": "^/" }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "filePrefix"],
          "properties": {
            "identity": { "type": "string", "minLength": 1 },
            "filePrefix": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
            "caAliases": { "type": "array", "items": { "type": "string" } }
          }
        },
        "snapshots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mount", "readOnly", "path"],
          "properties": {
            "mount": { "type": "boolean" },
            "readOnly": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "postgresCa": { "type": "boolean" },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mount", "path"],
          "properties": {
            "mount": { "type": "boolean" },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "extraVolumes": { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
