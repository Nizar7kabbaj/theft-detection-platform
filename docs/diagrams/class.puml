  class BronzeDetections <<delta>> #e8f0fe {
    + session_id : Long
    + frame_index : Int
    + camera_id : String
    + class_name : String
    + confidence : Double
    + ingested_at : Timestamp
  }
  class BronzeAlerts <<delta>> #e8f0fe {
    + alert_id : String
    + session_id : Long
    + severity : String
    + alert_type : String
    + ingested_at : Timestamp
  }
  class BronzePresenceEvents <<delta>> #e8f0fe {
    + event_id : String
    + kind : String
    + camera_id : String
    + session_id : Long
    + track_id : Int
    + ingested_at : Timestamp
  }
  class SilverSessions <<delta>> #e8f0fe {
    + session_id : Long
    + camera_id : String
    + start_ts : Timestamp
    + end_ts : Timestamp
    + detection_count : Int
    + alert_count : Int
  }
  class SilverDetectionsLabeled <<delta>> #e8f0fe {
    + detection_id : String
    + session_id : Long
    + label : String
    + labeled_by : String
    + labeled_at : Timestamp
  }
  class GoldDailyKpis <<delta>> #e8f0fe {
    + date : Date
    + camera_id : String
    + alert_count : Int
    + ack_rate : Double
    + top_object : String
    + mean_confidence : Double
  }
  class GoldDriftBaseline <<delta>> #e8f0fe {
    + feature_name : String
    + baseline_distribution : Array
    + computed_at : Timestamp
  }
}

note bottom of BronzePresenceEvents
  bronze tables mirror their source collection or proto.
  silver is cleaned per-session; gold is the serving layer.
end note

