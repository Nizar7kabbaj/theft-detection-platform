package "notification-service — inbound DTO" {
  class AlertmanagerWebhook <<dto>> #f5f5f5 {
    + version : String
    + group_key : String
    + status : String
    + receiver : String
    + external_url : String
    + to_telegram_html() : String
  }
  class AlertmanagerAlert <<dto>> #f5f5f5 {
    + status : String
    + starts_at : DateTime
    + ends_at : DateTime [0..1]
    + generator_url : String [0..1]
    + fingerprint : String [0..1]
  }
}

note bottom of AlertmanagerWebhook
  to_telegram_html couples inbound format to one output
  channel.Moves rendering to a per-channel renderer off
  this DTO.
end note

' ============================================================
package "privacy-service (MongoDB)" {
  class DataSubject <<document>> #dae8fc {
    + id : ObjectId
    + data_subject_id : String {unique}
    + display_name : String [0..1]
    + created_at : DateTime
    + created_reason : CreatedReason
    + erasure_requested : Boolean = false
    + erasure_requested_at : DateTime [0..1]
    + erasure_requested_by : String [0..1]
    + erasure_completed : Boolean = false
    + erasure_completed_at : DateTime [0..1]
    + suppression_active : Boolean = false
    + suppression_mode : SuppressionMode [0..1]
    + suppression_activated_at : DateTime [0..1]
  }
  enum CreatedReason <<enum>> #fff2cc {
    FACE_MATCH
    EMPLOYEE_BADGE
    ERASURE_REQUEST_FILED
    MANUAL_ADMIN_ENTRY
  }
  enum SuppressionMode <<enum>> #fff2cc {
    BLUR_FACE_ONLY
    DROP_SNAPSHOT
    DROP_ALL
  }
  enum ErasureStore <<enum>> #fff2cc {
    MONGO
    BLOB
    DELTA
    AUDIT_LOG
  }
  class SubjectReferences <<value>> #e1d5e7 {
    + mongo_detection_ids : String [0..*]
    + mongo_notification_ids : String [0..*]
    + blob_snapshot_keys : String [0..*]
    + audit_log_event_ids : String [0..*]
  }
  class DeltaRowRef <<value>> #e1d5e7 {
    + table : String
    + primary_key : String
  }
  class ErasureStep <<value>> #e1d5e7 {
    + store : ErasureStore
    + started_at : DateTime
    + finished_at : DateTime [0..1]
    + records_processed : Int
    + records_failed : Int
    + failure_reason : String [0..1]
  }
}

note bottom of SubjectReferences
  denormalized cross-store index for bounded-time erasure.
  source of truth stays in each store. audit_log entries are
  redacted with a tombstone, never deleted.
  enum literals pending privacy-service code confirmation.
end note

' ============================================================
package "Redis 7 — key/value classifiers" {
  class CacheEntry <<redis>> #d5e8d4 {
    + key : cache:{resource}:{params}
    + value : JSON
    + ttl : Duration
  }
  class IdempotencyKey <<redis>> #d5e8d4 {
    + key : idem:{method}:{path}:{header}
    + value : response_hash
    + ttl : 24h
  }
  class RefreshTokenBlocklist <<redis>> #d5e8d4 {
    + key : refresh_blocked:{jti}
    + value : reason
    + ttl : until_expiry
  }
  class LockoutCounter <<redis>> #d5e8d4 {
    + key : lockout:{username}
    + value : attempt_count
    + ttl : 15m
  }
  class CeleryQueue <<redis>> #d5e8d4 {
    + key : celery_queue
    + value : task_dict
  }
  class PubSubChannel <<redis>> #d5e8d4 {
    + channels : alerts:* , cameras:*
    + payload : JSON
  }
  class AnomalyScoreCache <<redis>> #d5e8d4 {
    + key : anomaly:{session_id}
    + value : Float
  }
  class CameraPendingCommands <<redis>> #d5e8d4 {
    + key : camera_pending:{camera_id}
    + value : CameraCommand_queue
  }
  class FeatureViewOnline <<redis>> #d5e8d4 {
    + key : feast:{view}:{entity}
    + value : feature_vector
  }
  class RateLimitCounter <<redis>> #d5e8d4 {
    + key : ratelimit:{key}
    + value : count
    + ttl : window
  }
}

