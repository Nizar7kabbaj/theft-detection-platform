  }
  class ModelArtifact <<blob>> #fde9d9 {
    + key : mlflow/{run_id}/artifacts/...
    + content_type : binary
  }
  class DvcArtifact <<blob>> #fde9d9 {
    + key : dvc/{md5}/...
    + content_type : binary
  }
}

