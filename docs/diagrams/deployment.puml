@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor Black
skinparam nodesep 25
skinparam ranksep 45
skinparam node {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
skinparam database {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
skinparam artifact {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
skinparam note {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}

title theft-detection-platform - deployment on the development host

node "Operator browser" as BROWSER
node "Telegram Bot API" as TG

node "Legion 5, Ubuntu, RTX 3070" <<device>> as HOST {

  artifact "C922 webcam" as DEV
  artifact "nvidia gpu" as GPU

  node "edge network" as EDGE {
    node "traefik\n80, 443" as TRAEFIK
    node "web\n3000" as WEB
    node "backend\n8000" as BE
    node "auth\n8000, 50053" as AUTH
  }

  node "data network, internal" as DATA {
    node "audit\n50054" as AUD
    node "notification-server\n50052" as NS
    node "notification-worker" as NW
    node "notification-beat" as NB
    database "mongo\n27017" as MONGO
    database "postgres\n5432" as PG
    database "redis cache\n6380" as REDIS
    database "redis-broker\n6380" as BROKER
    database "redis-stream\n6380" as STREAM
  }

  node "ai profile, started on demand" as AIPROF {
    node "ai\n50051" as AI
    node "camera" as CAM
    node "detect-gate" as GATE
  }

  node "named volumes" as VOLS {
    artifact "mongo_data" as VMONGO
    artifact "postgres_data" as VPG
    artifact "redis_data" as VREDIS
    artifact "redis_broker_data" as VBROKER
    artifact "ai_snapshots" as VSNAP
  }
}

BROWSER --> TRAEFIK : 127.0.0.1 443
NW --> TG : outbound https

DEV --> CAM : v4l2, group 44
GPU --> AI : nvidia runtime
GPU --> GATE : nvidia runtime

MONGO -- VMONGO
PG -- VPG
REDIS -- VREDIS
BROKER -- VBROKER
AI -- VSNAP

EDGE -[hidden]down- DATA
DATA -[hidden]down- AIPROF
AIPROF -[hidden]down- VOLS

note right of EDGE
  traefik holds a fixed address here and publishes
  80 and 443 on loopback only. backend and auth
  also join the data network to reach their stores,
  and publish 8001 and 8002 on loopback for probing
end note

note right of DATA
  this network has no route off the host. every
  store sits here, so no database is reachable
  from outside the machine
end note

note right of AIPROF
  these three start only with the ai profile. the
  gpu is passed to ai and detect-gate, the webcam
  only to camera. all three join the data network
  to reach the frame stream
end note

note right of VOLS
  redis-stream carries no volume, so frames do not
  survive a restart. every other store keeps a
  named volume on the host filesystem
end note

@enduml
