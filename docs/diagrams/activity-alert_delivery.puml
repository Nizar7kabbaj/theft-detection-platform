@startuml
title alert delivery and response
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  DiamondFontColor Black
  StartColor Black
  EndColor Black
  BarColor Black
}
skinparam note {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
skinparam swimlane {
  BorderColor Black
  TitleBackgroundColor White
  TitleFontSize 13
}

|notification-server|
start
:receive the stored alert;
:validate the payload;
if (payload valid?) then (no)
  :report the failure back and stop;
  kill
endif
:record a delivery intent;
:queue the delivery task;

fork
|notification-worker|
:take the task from the queue;
if (telegram gate raised?) then (yes)
  :buffer the intent until a probe clears the gate;
  kill
endif
:send the snapshot with a caption, or the text alone;
if (telegram accepted?) then (no)
  :retry with a growing delay, then move to the dead letter store;
  kill
endif
:mark the intent delivered;

fork again
|backend|
:push the alert over the open websockets;
|web|
:show the alert on the dashboard;
end fork

|operator|
:open the alert and review the snapshot;
:acknowledge the alert;

|backend|
:check the acknowledge permission;

|mongo|
:mark the alert acknowledged if it is not already;

|backend|
if (state changed?) then (no)
  :return the alert unchanged;
  kill
endif
:drop the cached alert pages;
:publish the acknowledgement;
:record the acknowledgement in the audit outbox;

|web|
:update the alert in place;
stop

@enduml
