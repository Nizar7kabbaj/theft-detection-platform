@startuml
title from frame to stored alert
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  DiamondFontColor Black
  StartColor Black
  EndColor Black
  BarColor Black
}
skinparam note {
  BackgroundColor White
  BorderColor Black
  FontColor Black
}
skinparam swimlane {
  BorderColor Black
  TitleBackgroundColor White
  TitleFontSize 13
}

|camera|
start
:capture a frame from the video device;
:append the frame to the stream;
note right
  the publisher keeps a bounded queue and drops
  the oldest frames when redis falls behind
end note

|detect-gate|
:read the frame from the stream;
:run person detection;
if (person in view?) then (no)
  :leave presence closed and read the next frame;
  kill
endif
:send a presence event to ai;

|camera|
:raise the capture rate and hold it for the dwell window;

|ai|
:read the frame from the stream;
:track people and objects, one identifier each;
:score the pose window for anomalies;
:check whether an object left the shelf near a person;
if (anomaly or concealment?) then (no)
  :keep the window open and wait for the next frame;
  kill
endif
:write the snapshot to disk;
:post the alert to the api;

|backend|
:check the write permission and the idempotency key;

|mongo|
:insert the alert document;

|backend|
:hand the alert to notification;
if (notification reachable?) then (no)
  :record the alert as pending dispatch;
endif
:drop the cached alert pages;
:publish the created alert;
stop

@enduml
