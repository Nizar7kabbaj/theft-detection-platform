@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #44546A
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EEF1F5
  BorderColor #44546A
  FontColor #1F2933
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #44546A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #8A94A6
  FontColor #1F2933
}
actor "Viewer" as viewer
actor "Operator" as operator
actor "Admin" as admin
actor "ML Engineer" as mleng
actor "Compliance Officer" as compliance
actor "Camera" as camera
actor "Detection Service" as detector
viewer <|-- operator
operator <|-- admin
rectangle "theft-detection-platform" {
  usecase "Log In" as UC_LOGIN
  usecase "Log Out" as UC_LOGOUT
  usecase "Lock Account" as UC_LOCK
  usecase "View Live Camera Feed" as UC_FEED
  usecase "Browse Alerts" as UC_ALERTS
  usecase "Browse Detections" as UC_DETECTIONS
  usecase "View Statistics" as UC_STATS
  usecase "Acknowledge Alert" as UC_ACK
  usecase "Decide on Alert" as UC_DECIDE
  usecase "Run Analysis" as UC_ANALYZE
  usecase "Manage Cameras" as UC_CAMERAS
  usecase "Manage Users" as UC_USERS
  usecase "Configure Detection Settings" as UC_SETTINGS
  usecase "Query Audit Log" as UC_QUERY
  usecase "Verify Audit Chain" as UC_VERIFY
  usecase "Erase Subject Data" as UC_ERASE
  usecase "Capture Video Stream" as UC_CAPTURE
  usecase "Submit Detection Alert" as UC_SUBMIT
  usecase "Deliver via Telegram" as UC_DELIVER
}
actor "Telegram Bot API" as telegram
viewer -- UC_LOGIN
viewer -- UC_LOGOUT
viewer -- UC_FEED
viewer -- UC_ALERTS
viewer -- UC_DETECTIONS
viewer -- UC_STATS
operator -- UC_ACK
operator -- UC_DECIDE
operator -- UC_ANALYZE
operator -- UC_CAMERAS
admin -- UC_USERS
admin -- UC_SETTINGS
mleng -- UC_DETECTIONS
mleng -- UC_STATS
compliance -- UC_QUERY
compliance -- UC_VERIFY
compliance -- UC_ERASE
camera -- UC_CAPTURE
detector -- UC_SUBMIT
UC_DELIVER -- telegram
UC_LOCK ..> UC_LOGIN : <<extend>>
UC_CAPTURE ..> UC_SUBMIT : <<include>>
UC_SUBMIT ..> UC_DELIVER : <<include>>
note bottom of UC_ERASE
  erasure and chain verification run from
  the audit command line tool
end note
note bottom of UC_LOCK
  login is blocked for 15 minutes after
  repeated failed attempts
end note
note bottom of UC_SUBMIT
  access, alert decisions and administration
  actions are appended to a hash-chained log
end note
@enduml
