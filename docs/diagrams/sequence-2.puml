@startuml
title Training flow: ingest, label, train, promote

skinparam participant {
  BackgroundColor #dae8fc
  BorderColor #6c8ebf
  FontName Arial
}
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #999999
  GroupBackgroundColor #f5f5f5
  GroupBorderColor #cccccc
  DividerBackgroundColor #eeeeee
}
skinparam database {
  BackgroundColor #fff2cc
  BorderColor #d6b656
}
skinparam queue {
  BackgroundColor #fff2cc
  BorderColor #d6b656
}
skinparam note {
  BackgroundColor #ffe6cc
  BorderColor #d79b00
}
hide footbox

actor "ML engineer" as mle
actor "Data labeller" as lab

database "mongodb" as mdb #F4B183
queue "redis (pub/sub)" as rpub #fff2cc

box "Data plane" #F5F5F5
  participant "ingest-service" as ing #A8D08D
  participant "analytics-service" as anl #A8D08D
end box

database "delta-lake on azure-blob" as dl #F4B183

box "Labelling" #F5F5F5
  participant "label-studio-service" as lss #A8D08D
end box

database "postgresql" as pg #F4B183

box "ML platform" #F5F5F5
  participant "drift-detection-service" as dd #A8D08D
  participant "feature-store-service" as fs #A8D08D
  participant "training-orchestrator-service" as tos #A8D08D
  participant "federated-aggregator-service" as fed #A8D08D
  participant "mlflow" as mlf #A8D08D
end box

box "Edge clients" #F5F5F5
  participant "edge agent" as edge #96CBFE
end box

participant "model-serving-service" as mss #A8D08D

== Ingest operational data to bronze ==

loop continuous
  mdb ->> ing : change streams (events, detections, alerts)
  activate ing
  rpub ->> ing : pub/sub (alerts:*, cameras:*)
  ing -> dl : append bronze
  deactivate ing
end

opt gap-filling batch
  ing -> mdb : query missed range
  mdb --> ing : missed records
  ing -> dl : append bronze
end

== Transform bronze to silver and gold ==

loop scheduled
  anl -> dl : read bronze
  activate anl
  dl --> anl : rows
  anl -> anl : PySpark transforms
  anl -> dl : write silver and gold
  deactivate anl
end

note over anl
  analytics also serves BI views to backend over HTTP
  and hands the weekly PDF report to notification-service;
  those flows belong to the runtime/serving view, not this one
end note

== Labelling ==

lab -> lss : open Label Studio
activate lss
lss -> pg : load samples
pg --> lss : sample set
lss --> lab : show samples
lab -> lss : annotate (theft / not theft)
lss -> pg : store labels
lss -> dl : export labelled dataset to silver
deactivate lss

note over lab, lss
  labelling trigger
  (auto-queue from alerts, scheduled sample,
  or manual selection) TBD
end note

== Drift detection ==

loop scheduled
  dd -> dl : read recent keypoint distribution
  activate dd
  dl --> dd : recent
  dd -> dl : read baseline distribution
  dl --> dd : baseline
  dd -> dd : KS-test
  opt drift detected
    dd ->> tos : trigger retrain
  end
  deactivate dd
end

note over dd
  inventory: drift alerts emitted to Alertmanager on
  threshold breach; retrain trigger routing
  (direct to orchestrator vs via Alertmanager) open
end note

== Training trigger ==

alt drift-driven
  dd ->> tos : trigger retrain
else scheduled
  tos -> tos : cron tick
else manual
  mle -> tos : trigger run
end

== Feature retrieval ==

activate tos
tos -> fs : request offline features
activate fs
fs -> dl : read offline store
dl --> fs : features
fs --> tos : feature set
deactivate fs

note over fs
  online store (redis-backed) serves features to
  inference; that path lives in the runtime detection flow
end note

== Train ==

tos -> dl : checkout dataset version (DVC)
dl --> tos : dataset
tos -> tos : run PoseConv3D training (Argo steps)
tos ->> mlf : log params, metrics, artifacts
activate mlf
mlf -> pg : write run metadata
pg --> mlf : ok
mlf -> dl : store model artifact
dl --> mlf : artifact uri
mlf --> tos : run id
deactivate mlf

== Federated round (parallel path) ==

loop per round
  fed ->> edge : push global weights
  activate edge
  edge -> edge : local training on store data
  edge -->> fed : weight delta
  deactivate edge
  fed -> fed : aggregate
end
fed ->> mlf : log federated run

note over fed, edge
  edge client placement
  (camera-service or dedicated edge agent)
  TBD pending edge-runtime design
end note

== Promote winning model ==

mle -> mlf : compare runs
activate mle
activate mlf
mlf --> mle : best run id
mle -> mlf : promote to Production stage
mlf -> pg : update stage transition
deactivate mle

mss -> mlf : poll Model Registry
activate mss
mlf --> mss : new Production version available
deactivate mlf
mss -> dl : pull artifact
dl --> mss : weights
mss -> mss : hot-swap version (no restart)
deactivate mss

note over mss
  ai-service does not load models
  it calls model-serving-service per frame
  swap is transparent to ai-service
end note
deactivate tos

@enduml
