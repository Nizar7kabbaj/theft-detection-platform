@startuml
title adding a camera
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam activity {
  BackgroundColor #EEF1F5
  BorderColor #44546A
  ArrowColor #44546A
  FontColor #1F2933
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #8A94A6
}
skinparam swimlane {
  BorderColor #8A94A6
  TitleBackgroundColor #FFFFFF
  TitleFontSize 13
}
|operator|
start
:open the camera page;
:submit name and device path;
|frontend|
:post to /api/v1/cameras with session cookie;
|backend|
:resolve permissions from token roles;
if (camera write granted?) then (no)
  |backend|
  :return 403;
  kill
endif
|backend|
if (idempotency key already used?) then (yes)
  |backend|
  :return the stored response;
  kill
endif
|backend|
:validate the request body;
if (body valid?) then (no)
  |backend|
  :return 422;
  kill
endif
|mongodb|
:insert the camera document;
|backend|
if (name already taken?) then (yes)
  |backend|
  :return 409;
  kill
endif
|backend|
:drop the cached camera list;
:record the create in the audit outbox;
note right
  audit events go to an outbox collection and
  reach the audit service through a background
  loop, so the response does not wait for them
end note
|redis|
:publish cameras created;
|backend|
:store the response under the idempotency key;
:return 201;
|frontend|
:refresh the camera list;
|operator|
:see the new camera;
stop
@enduml
