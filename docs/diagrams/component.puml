@startuml
skinparam component {
  BackgroundColor #dae8fc
  BorderColor #6c8ebf
  FontName Arial
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #cccccc
}
skinparam interface {
  BackgroundColor #f5f5f5
  BorderColor #666666
}

package "theft-detection-platform" {

  package "Inference Plane" {
    component "camera-service" as CAM #dae8fc
    component "detect-gate-service" as DET #dae8fc
    component "ai-service" as AI #dae8fc
    component "adversarial-defense-service" as DEF #dae8fc
    component "model-serving-service" as MSRV #dae8fc {
      component "Triton" as TRI #d5e8d4
    }
    component "backend" as BE #dae8fc
    component "notification-service" as NOTIF #ffe6cc
    component "notification-worker" as NW #ffe6cc
  }

  package "Identity, Security & Compliance" {
    component "auth-service" as AUTH #fff2cc
    component "audit-service" as AUD #fff2cc
    component "privacy-service" as PRIV #fff2cc
  }

  package "Data Plane" {
    component "ingest-service" as ING #dae8fc
    component "analytics-service" as ANL #dae8fc
  }

  package "ML Platform Plane" {
    component "training-orchestrator-service" as TRAIN #d5e8d4
    component "drift-detection-service" as DRIFT #d5e8d4
    component "federated-aggregator-service" as FAG #d5e8d4
    component "MLflow" as MLF #d5e8d4
    component "Label Studio" as LS #d5e8d4
    component "Feast" as FEAST #d5e8d4
  }

  package "Frontend" {
    component "frontend" as FE #ffe6cc
  }

  package "Data Stores" {
    component "MongoDB" as MONGO #e1d5e7
    component "Redis" as REDIS #e1d5e7
    component "PostgreSQL" as PG #e1d5e7
    component "Delta Lake\n(Azure Blob)" as DELTA #e1d5e7
  }
}

package "External Systems" {
  component "Camera\n(V4L2 USB)" as USBCAM #f8cecc
  component "Operator Browser" as BROWSER #f8cecc
  component "Alertmanager" as AM #f8cecc
  component "Telegram Bot API" as TG #f8cecc
  component "Federated Edge Client" as FEC #f8cecc
}

interface "inference.proto" as iInfer
interface "presence.proto" as iPres
interface "defense.proto" as iDef
interface "notification.proto" as iNotif
interface "auth.proto" as iAuth
interface "audit.proto" as iAudit
interface "camera_control.proto" as iCtrl

AI -- iInfer
iInfer )-- BE

AI -- iPres
iPres )-- DET

DEF -- iDef
iDef )-- AI

NOTIF -- iNotif
iNotif )-- BE

AUTH -- iAuth
iAuth )-- BE

AUD -- iAudit
iAudit )-- AUTH
iAudit )-- BE
iAudit )-- AI
iAudit )-- PRIV
iAudit )-- NW

BE -- iCtrl
iCtrl )-- CAM

USBCAM ..> CAM : V4L2 frames
BROWSER ..> FE : HTTPS
FE ..> BE : REST /api/v1/*
BE ..> FE : WebSocket /ws

CAM ..> DET : frame transport
AI ..> MSRV : forward pass (gRPC)
AI ..> BE : theft event (gRPC)

MSRV ..> MLF : registry pull (swap)
MSRV ..> DELTA : pull model weights

BE ..> MONGO : cameras, detections, alerts, stats
BE ..> REDIS : cache, pub/sub, idempotency
BE ..> ANL : HTTP BI views

NOTIF ..> REDIS : enqueue (Celery broker)
NOTIF ..> MONGO : notifications
NW ..> REDIS : consume (Celery broker)
NW ..> TG : sendPhoto / sendMessage
AM ..> NOTIF : webhook (HTTP)
ANL ..> NOTIF : weekly report handoff

MONGO ..> ING : change streams
REDIS ..> ING : pub/sub
ING ..> DELTA : append bronze
ANL ..> DELTA : read bronze, write silver / gold

DRIFT ..> DELTA : keypoint distributions
DRIFT ..> AM : drift alerts
TRAIN ..> MLF : log runs
TRAIN ..> DELTA : training data (DVC)
TRAIN ..> FEAST : offline features
LS ..> PG : metadata
LS ..> DELTA : export to silver
MLF ..> PG : run metadata
MLF ..> DELTA : artifacts
FEAST ..> DELTA : offline store
FEAST ..> REDIS : online store
FAG <..> FEC : federated round (gRPC)
FAG ..> MLF : log federated run

PRIV ..> MONGO : data_subjects, erasure
PRIV ..> DELTA : erasure cascade
AUD ..> MONGO : audit_log
AUTH ..> MONGO : users, sessions, refresh_tokens, lockouts

note bottom of CAM
  frame transport to detect-gate
  (event hub, grpc stream, or shared fs)
  deferred to gap-list step 5
end note

note bottom of AI
  pull-based gRPC inference, active only after
  person-entered. also emits theft events to
  notification-service; that direct path is not
  yet a contract row, so only backend is wired
end note

note bottom of NOTIF
  alert.proto renames to notification.
  proto in delivery unified on the celery
  path; no direct service-to-telegram arrow
end note

note right of TRI
  triton is the forward-pass engine inside
  model-serving-service, not a separate service
end note

note bottom of AUD
  audit.proto consumed by nine internal services
  plus backend compliance reads. wired here: the
  emitters with a grounded payload or sequence;
  full set pinned when the remaining protos close
end note

note bottom of REDIS
  observability plane and otlp / scrape / health
  overlays are scoped to the deployment view
end note

@enduml
