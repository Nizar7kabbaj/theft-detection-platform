{
  "info": {
    "name": "notification-service",
    "description": "webhook and reliability checks for the notification service. covers alertmanager ingress, bearer enforcement, and duplicate-groupkey idempotency at the acquire seam.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "alertmanager webhook / happy path",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const gk = 'postman-' + Date.now();",
              "pm.collectionVariables.set('group_key', gk);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 202', () => pm.response.to.have.status(202));",
              "pm.test('response time under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{webhook_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/webhooks/alertmanager",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "alertmanager"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": \"4\",\n  \"groupKey\": \"{{group_key}}\",\n  \"status\": \"firing\",\n  \"receiver\": \"notification-service\",\n  \"groupLabels\": { \"alertname\": \"PostmanCheck\" },\n  \"commonLabels\": {\n    \"alertname\": \"PostmanCheck\",\n    \"severity\": \"warning\",\n    \"service\": \"notification-postman\"\n  },\n  \"commonAnnotations\": { \"summary\": \"happy path from postman\" },\n  \"externalURL\": \"http://alertmanager:9093\",\n  \"alerts\": [\n    {\n      \"status\": \"firing\",\n      \"labels\": {\n        \"alertname\": \"PostmanCheck\",\n        \"severity\": \"warning\",\n        \"service\": \"notification-postman\"\n      },\n      \"annotations\": { \"summary\": \"happy path from postman\" },\n      \"startsAt\": \"2026-07-06T00:00:00Z\",\n      \"endsAt\": null,\n      \"generatorURL\": \"http://prometheus:9090\",\n      \"fingerprint\": \"postman-fp-happy\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "alertmanager webhook / missing bearer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/webhooks/alertmanager",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "alertmanager"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": \"4\",\n  \"groupKey\": \"postman-no-bearer\",\n  \"status\": \"firing\",\n  \"receiver\": \"notification-service\",\n  \"groupLabels\": { \"alertname\": \"PostmanUnauthorized\" },\n  \"commonLabels\": { \"alertname\": \"PostmanUnauthorized\" },\n  \"commonAnnotations\": {},\n  \"externalURL\": \"http://alertmanager:9093\",\n  \"alerts\": [\n    {\n      \"status\": \"firing\",\n      \"labels\": { \"alertname\": \"PostmanUnauthorized\" },\n      \"annotations\": {},\n      \"startsAt\": \"2026-07-06T00:00:00Z\",\n      \"endsAt\": null,\n      \"generatorURL\": \"http://prometheus:9090\",\n      \"fingerprint\": \"postman-fp-unauth\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "alertmanager webhook / duplicate group key",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const gk = pm.collectionVariables.get('dup_group_key') || ('postman-dup-' + Date.now());",
              "pm.collectionVariables.set('dup_group_key', gk);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 202', () => pm.response.to.have.status(202));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{webhook_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/webhooks/alertmanager",
          "host": ["{{base_url}}"],
          "path": ["webhooks", "alertmanager"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"version\": \"4\",\n  \"groupKey\": \"{{dup_group_key}}\",\n  \"status\": \"firing\",\n  \"receiver\": \"notification-service\",\n  \"groupLabels\": { \"alertname\": \"PostmanIdempotency\" },\n  \"commonLabels\": {\n    \"alertname\": \"PostmanIdempotency\",\n    \"severity\": \"warning\"\n  },\n  \"commonAnnotations\": { \"summary\": \"same group key fires twice\" },\n  \"externalURL\": \"http://alertmanager:9093\",\n  \"alerts\": [\n    {\n      \"status\": \"firing\",\n      \"labels\": {\n        \"alertname\": \"PostmanIdempotency\",\n        \"severity\": \"warning\"\n      },\n      \"annotations\": { \"summary\": \"same group key fires twice\" },\n      \"startsAt\": \"2026-07-06T00:00:00Z\",\n      \"endsAt\": null,\n      \"generatorURL\": \"http://prometheus:9090\",\n      \"fingerprint\": \"postman-fp-dup\"\n    }\n  ]\n}"
        }
      }
    }
  ],
  "variable": [
    { "key": "group_key", "value": "" },
    { "key": "dup_group_key", "value": "" }
  ]
}
