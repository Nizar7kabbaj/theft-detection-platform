REDIS_HOST=redis-stream
REDIS_TLS=true
REDIS_DB=2
REDIS_USER=camera
REDIS_PASSWORD_FILE=/run/secrets/camera_redis_password

# TLS identity — same certificate used for the grpc client
TLS_CERT_FILE=/run/secrets/camera_tls_cert
TLS_KEY_FILE=/run/secrets/camera_tls_key
TLS_CA_FILE=/run/secrets/camera_tls_ca

# Frame stream
FRAME_STREAM_PREFIX=frame
FRAME_STREAM_MAXLEN=900
DETECT_STREAM_PREFIX=detect
DETECT_STREAM_MAXLEN=300

# Edge stats
# fps and analyze round-trip latency, written once per interval and expired by
# redis so a dead camera reads as absent rather than stale
STATS_KEY_PREFIX=stats:camera
STATS_INTERVAL_SECONDS=1.0
STATS_TTL_SECONDS=10
PUBLISH_QUEUE_DEPTH=30

# Capture
IDLE_FPS=15
ACTIVE_FPS=30
LOG_LEVEL=INFO
DEBUG=false
