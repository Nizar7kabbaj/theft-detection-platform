REDIS_HOST=redis-stream
REDIS_TLS=true
REDIS_DB=2
REDIS_USER=gate
REDIS_PASSWORD_FILE=/run/secrets/gate_redis_password

# TLS identity — same certificate used for the grpc client
TLS_CERT_FILE=/run/secrets/gate_tls_cert
TLS_KEY_FILE=/run/secrets/gate_tls_key
TLS_CA_FILE=/run/secrets/gate_tls_ca

# Frame source
FRAME_SOURCE=camera
FRAME_STREAM_PREFIX=frame
FRAME_READ_BLOCK_MS=2000

# Detection
MODEL_NAME=yolov8n.pt
MODEL_DEVICE=cuda
DETECTION_CONFIDENCE=0.5
EXIT_DEBOUNCE_FRAMES=30
GATE_FPS=15
LOG_LEVEL=INFO
DEBUG=false
