# auth service configuration
AUTH_SERVICE_NAME=auth
AUTH_HTTP_HOST=0.0.0.0
AUTH_HTTP_PORT=8000
AUTH_GRPC_HOST=0.0.0.0
AUTH_GRPC_PORT=50053
AUTH_GRPC_MAX_WORKERS=8
AUTH_LOG_LEVEL=info

# postgres
AUTH_POSTGRES_HOST=postgres
AUTH_POSTGRES_PORT=5432
AUTH_POSTGRES_DB=authdb

# postgres tls: verify-full (default, needs the ca file) or disable (compose postgres has no tls)
AUTH_POSTGRES_SSL_MODE=verify-full
AUTH_POSTGRES_SSL_CA_FILE=/run/postgres-ca/ca.crt
