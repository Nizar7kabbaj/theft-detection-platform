REDIS_HOST=redis-stream
REDIS_TLS=true
REDIS_DB=2

# Node stats
# gpu temperature and utilisation read through nvml, expired by redis so a
# stopped service reads as absent
NODE_STATS_KEY=stats:node
NODE_STATS_INTERVAL_SECONDS=2.0
NODE_STATS_TTL_SECONDS=15
NODE_STATS_DEVICE_INDEX=0
REDIS_USER=ai
REDIS_PASSWORD_FILE=/run/secrets/ai_redis_password

# TLS identity — same certificate used for the grpc listener
TLS_CERT_FILE=/run/secrets/ai_tls_cert
TLS_KEY_FILE=/run/secrets/ai_tls_key
TLS_CA_FILE=/run/secrets/ai_tls_ca

# Inference
DEVICE=cuda
ANOMALY_THRESHOLD=0.6
TRACKER_TTL_SECONDS=60
LOG_LEVEL=INFO
DEBUG=false
CONCEALMENT_MISSING_SECONDS=3.0
