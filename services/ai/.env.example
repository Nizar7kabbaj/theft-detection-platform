REDIS_HOST=redis-stream
REDIS_TLS=true
REDIS_DB=2
REDIS_USER=ai
REDIS_PASSWORD_FILE=/run/secrets/ai_redis_password

# TLS identity — same certificate used for the grpc listener
TLS_CERT_FILE=/run/secrets/ai_tls_cert
TLS_KEY_FILE=/run/secrets/ai_tls_key
TLS_CA_FILE=/run/secrets/ai_tls_ca

# Inference
DEVICE=cuda
ANOMALY_THRESHOLD=0.6
TRACKER_TTL_SECONDS=60
LOG_LEVEL=INFO
DEBUG=false
