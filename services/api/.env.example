# api service

API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
DATABASE_NAME=theft_detection_db
SNAPSHOTS_DIR=/app/snapshots
ALERTS_DIR=ai-model/outputs/alerts

# mongo and redis connection settings are omitted on purpose. The defaults in
# app/core/config.py already match the compose service names and the secret
# mount paths under /run/secrets, so the live file carries none of them. Set
# them here only to point a service at a host outside the compose network.

# telemetry
# compose sets these in the environment block of every service, which wins over
# this file. Kept here so the expected values are visible in one place.

OTEL_SERVICE_NAME=theft-backend
OTEL_RESOURCE_ATTRIBUTES=service.namespace=theft,deployment.environment=local,service.version=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://theft-alloy:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus
OTEL_LOGS_EXPORTER=none
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] [trace_id=%(otelTraceID)s span_id=%(otelSpanID)s] %(message)s
PROMETHEUS_EXPORTER_PORT=9464

# system telemetry
# the panel reads host and per-service metrics through prometheus. The default
# in app/core/config.py matches the compose service name, so nothing is set
# here. Point PROMETHEUS_URL elsewhere only when prometheus runs outside the
# compose network. The window and step control how much history the sparklines
# draw; step must divide the window evenly or the last point is short.
# PROMETHEUS_URL=http://prometheus:9090
# PROMETHEUS_TIMEOUT_SECONDS=3.0
# SYSTEM_STATS_TTL_SECONDS=10
# SYSTEM_HISTORY_TTL_SECONDS=15
# SYSTEM_HISTORY_WINDOW_SECONDS=900
# SYSTEM_HISTORY_STEP_SECONDS=30

# notification service
# notification-service, notification-worker and notification-beat all load this
# same file. The bot token is read from a mounted file, so only the chat id is
# set through the environment.

TELEGRAM_CHAT_ID=<telegram-chat-id>

# compose variable substitution
# the repo root .env symlinks to this file, so compose reads these three for
# ${...} expansion in docker-compose.yml. No python service reads them.

MONGO_EXPORTER_USERNAME=theft_monitor
MONGO_EXPORTER_PASSWORD=<password-generated-during-install>
GF_SECURITY_ADMIN_PASSWORD=<password-generated-during-install>
