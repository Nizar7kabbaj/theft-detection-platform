# audit service configuration
AUDIT_SERVICE_NAME=audit
AUDIT_GRPC_HOST=0.0.0.0
AUDIT_GRPC_PORT=50054
AUDIT_GRPC_MAX_WORKERS=8
AUDIT_LOG_LEVEL=info

# postgres
AUDIT_POSTGRES_HOST=postgres
AUDIT_POSTGRES_PORT=5432
AUDIT_POSTGRES_DB=auditdb
AUDIT_POSTGRES_APP_USER=audit_app
AUDIT_POSTGRES_APP_PASSWORD_FILE=/run/secrets/audit_app_postgres_password
AUDIT_POSTGRES_OWNER_USER=audit_owner
AUDIT_POSTGRES_OWNER_PASSWORD_FILE=/run/secrets/audit_owner_postgres_password

# redis
AUDIT_REDIS_HOST=redis
AUDIT_REDIS_PORT=6379
AUDIT_REDIS_USER=audit
AUDIT_REDIS_DB=0
AUDIT_REDIS_PASSWORD_FILE=/run/secrets/audit_redis_password

# rate limiting
AUDIT_APPEND_RATE_LIMIT=2000
AUDIT_APPEND_RATE_WINDOW_SECONDS=1
