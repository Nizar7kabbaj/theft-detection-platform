# audit service configuration
AUDIT_SERVICE_NAME=audit
AUDIT_GRPC_HOST=0.0.0.0
AUDIT_GRPC_PORT=50054
AUDIT_GRPC_MAX_WORKERS=8
AUDIT_LOG_LEVEL=info

# postgres
AUDIT_POSTGRES_HOST=postgres
AUDIT_POSTGRES_PORT=5432
AUDIT_POSTGRES_DB=auditdb
AUDIT_POSTGRES_APP_USER=audit_app
AUDIT_POSTGRES_APP_PASSWORD_FILE=/run/secrets/audit_app_postgres_password
AUDIT_POSTGRES_OWNER_USER=audit_owner
AUDIT_POSTGRES_OWNER_PASSWORD_FILE=/run/secrets/audit_owner_postgres_password

# redis
AUDIT_REDIS_HOST=redis
AUDIT_REDIS_PORT=6380
AUDIT_REDIS_USER=audit
AUDIT_REDIS_DB=0
AUDIT_REDIS_PASSWORD_FILE=/run/secrets/audit_redis_password

# rate limiting
AUDIT_APPEND_RATE_LIMIT=2000
AUDIT_APPEND_RATE_WINDOW_SECONDS=1

# schema
AUDIT_SCHEMA_VERSION=1
AUDIT_MIN_ACCEPTED_SCHEMA_VERSION=1

# pseudonymisation
AUDIT_PSEUDONYM_KEY_FILE=/run/secrets/audit_pseudonym_key
AUDIT_PSEUDONYM_KEY_ID=p1

# checkpoint signing
AUDIT_CHECKPOINT_PRIVATE_KEY_FILE=/run/secrets/audit_checkpoint_private_key
AUDIT_CHECKPOINT_PUBLIC_KEY_FILE=/run/secrets/audit_checkpoint_public_key
AUDIT_CHECKPOINT_KEY_ID=c1
AUDIT_CHECKPOINT_INTERVAL_EVENTS=1000
AUDIT_CHECKPOINT_INTERVAL_SECONDS=300

# retention
AUDIT_RETENTION_DAYS=365
AUDIT_SEGMENT_INTERVAL_DAYS=30

# service tls
AUDIT_TLS_ENABLED=true
AUDIT_TLS_CERT_FILE=/run/secrets/audit_tls_cert
AUDIT_TLS_KEY_FILE=/run/secrets/audit_tls_key
AUDIT_TLS_CA_FILE=/run/secrets/audit_tls_ca
AUDIT_TLS_REQUIRE_CLIENT_AUTH=true
