NEXT_PUBLIC_APP_NAME=theft detection platform

# Server-only. Read in server components, route handlers and proxy.ts.
# Never reaches the browser. Real values live in .env.local, which is gitignored.
# API_BASE_URL=
# AUTH_BASE_URL=

# Relaxes the content security policy so hot reload can run. Turbopack compiles
# updates to strings and evaluates them, which needs unsafe-eval, and the dev overlay
# injects stylesheets. The dev script already sets this, so it does not belong here.
# Only honoured when the build is a development build. A production build ignores it
# entirely, so setting it on a deployed instance changes nothing.
# Run dev:strict to serve the production policy locally and see what it would block.
