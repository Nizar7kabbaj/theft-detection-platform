global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: local
    project: theft-detection-platform

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090

  - job_name: node
    static_configs:
      - targets:
          - node-exporter:9100

  - job_name: mongodb
    static_configs:
      - targets:
          - mongodb-exporter:9216

  - job_name: redis
    static_configs:
      - targets:
          - redis-exporter:9121

  - job_name: backend
    metrics_path: /metrics
    static_configs:
      - targets:
          - backend:9464
        labels:
          service: theft-backend

  - job_name: tempo
    static_configs:
      - targets:
          - tempo:3200
        labels:
          service: theft-tempo

  - job_name: traefik
    metrics_path: /metrics
    static_configs:
      - targets:
          - traefik:8082
        labels:
          service: theft-traefik
